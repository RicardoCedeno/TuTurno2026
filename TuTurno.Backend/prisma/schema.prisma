generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model User {
id String @id @default(uuid())
name String
email String @unique
password String // Hash de la contraseña temporal o definitiva
phone String?
avatar String? // Foto de perfil para el dashboard

// Roles y Estado administrativo
role Role @default(RECEPCIONIST)
active Boolean @default(true) // Permite suspender accesos fácilmente

// Seguridad JWT y Sesiones
refreshToken String?
resetToken String?
resetTokenExp DateTime?

// Control de auditoría
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

// Relación obligatoria para un SaaS: ¿A qué negocio pertenece este usuario?
locationId String
location Location @relation(fields: [locationId], references: [id])

@@map("users")
}

enum Role {
SUPERADMIN // Tú (para soporte global del SaaS)
ADMIN // El dueño del consultorio/clínica (paga la suscripción)
MEDICO // El profesional que consulta su agenda
RECEPCIONIST // La persona que gestiona las citas de todos
}

model Specialty {
id String @id @default(uuid())
name String
description String
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

doctorsSpecialties DoctorsSpecialties[]

@@map("specialties")
}

model Doctor {
id String @id @default(uuid())
name String
email String @unique
phone String
address String
city String
state String
country String
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

doctorsSpecialties DoctorsSpecialties[]
availability DoctorAvailability[]
unavailability DoctorUnavailability[]
appointments Appointment[]
procedures         Procedure[]

@@map("doctors")
}

model DoctorsSpecialties {
id String @id @default(uuid())
doctorId String
specialtyId String
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

doctor Doctor @relation(fields: [doctorId], references: [id])
specialty Specialty @relation(fields: [specialtyId], references: [id])

@@unique([doctorId, specialtyId])
@@map("doctors_specialties")
}

// ==================
// PACIENTES
// ==================

model Patient {
id String @id @default(uuid())
name String
email String @unique
phone String
birthDate DateTime
gender String // male | female | other
address String?
city String?
state String?
country String?
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

appointments Appointment[]
notifications Notification[]
procedures    Procedure[]

@@map("patients")
}

// ==================
// CONSULTORIOS
// ==================

// Sede o clinica (un consultorio puede tener varias sedes)
model Location {
id String @id @default(uuid())
name String // Ej: "Sede Norte", "Clínica Central"
address String
city String
state String
country String
phone String?
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

offices Office[]
users User[]

@@map("locations")
}

// Sala o consultorio fisico donde se atiende al paciente
model Office {
id String @id @default(uuid())
locationId String
name String // Ej: "Consultorio 1", "Sala B"
floor String?
description String?
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

location Location @relation(fields: [locationId], references: [id])
appointments Appointment[]

@@map("offices")
}

// ==================
// DISPONIBILIDAD
// ==================

// Franjas horarias recurrentes por dia de semana
model DoctorAvailability {
id String @id @default(uuid())
doctorId String
dayOfWeek Int // 0=domingo, 1=lunes ... 6=sabado
startTime String // Ej: "08:00"
endTime String // Ej: "17:00"
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

doctor Doctor @relation(fields: [doctorId], references: [id])

@@unique([doctorId, dayOfWeek, startTime])
@@map("doctor_availability")
}

// Excepciones a la disponibilidad recurrente (vacaciones, permisos, festivos)
model DoctorUnavailability {
id String @id @default(uuid())
doctorId String
startDate DateTime
endDate DateTime
reason String? // Ej: "Vacaciones", "Congreso médico"
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

doctor Doctor @relation(fields: [doctorId], references: [id])

@@map("doctor_unavailability")
}

// ==================
// CITAS
// ==================

model Appointment {
id String @id @default(uuid())
patientId String
doctorId String
officeId String
date DateTime // Fecha y hora exacta de la cita
duration Int @default(30) // Minutos
status String @default("scheduled")
// scheduled | confirmed | cancelled | completed | no_show
notes String? // Motivo de consulta
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

patient Patient @relation(fields: [patientId], references: [id])
doctor Doctor @relation(fields: [doctorId], references: [id])
office Office @relation(fields: [officeId], references: [id])
cancellation AppointmentCancellation?
notifications Notification[]

procedureId String?
procedureSession Int? // Ej: sesión 3 de 8

payments         Payment[]
procedure        Procedure? @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

// Separada de Appointment para guardar quien cancelo y por que
model AppointmentCancellation {
id String @id @default(uuid())
appointmentId String @unique
cancelledBy String // patient | doctor | admin
reason String?
cancelledAt DateTime @default(now())

appointment Appointment @relation(fields: [appointmentId], references: [id])

@@map("appointment_cancellations")
}

// ==================
// NOTIFICACIONES
// ==================

// Recordatorios y confirmaciones enviados al paciente
model Notification {
id String @id @default(uuid())
patientId String
appointmentId String?
type String
// appointment_reminder | appointment_confirmed | appointment_cancelled
channel String // email | sms | whatsapp
status String @default("pending")
// pending | sent | failed
scheduledAt DateTime // Cuando debe enviarse
sentAt DateTime? // Cuando se envio realmente
createdAt DateTime @default(now())

patient Patient @relation(fields: [patientId], references: [id])
appointment Appointment? @relation(fields: [appointmentId], references: [id])

@@map("notifications")
}

model Procedure {
id String @id @default(uuid())
patientId String
doctorId String
name String // "Ortodoncia fase 1", "Ciclo de quimioterapia"
description String?
totalSessions Int // Cuántas citas se planean en total
totalPrice Decimal @db.Decimal(10, 2) // Precio total acordado
status String @default("active") // active | completed | cancelled
startDate DateTime?
endDate DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

patient Patient @relation(fields: [patientId], references: [id])
doctor Doctor @relation(fields: [doctorId], references: [id])
appointments Appointment[]
payments Payment[]

@@map("procedures")
}

model Payment {
  id            String    @id @default(uuid())
  appointmentId String?   // Si es pago de cita simple
  procedureId   String?   // Si es abono a un procedimiento
  amount        Decimal   @db.Decimal(10, 2)
  method        String    // cash | card | transfer | insurance
  status        String    @default("completed") // pending | completed | refunded
  notes         String?
  paidAt        DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  procedure     Procedure?   @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("payments")
}
